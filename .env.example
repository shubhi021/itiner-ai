# Google Gemini API Key (Required for AI itinerary generation & activity pivots)
# Get a free API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# OpenWeatherMap API Key (Required for live destination weather context)
# Get a free API key at: https://home.openweathermap.org/api_keys
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key_here

# Google Maps / Places API Key (Optional / if using Google Maps SDK)
# Get an API key at: https://console.cloud.google.com/
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
GOOGLE_API_KEY=your_google_maps_api_key_here
